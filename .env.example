# FinGuard AI Environment Configuration Template

# Database Connection (PostgreSQL for Docker/Production, SQLite fallback for local quick-start)
DATABASE_URL=postgresql://finguard_user:finguard_pass@localhost:5432/finguard_db
# DATABASE_URL=sqlite:///./finguard.db

# JWT & Authentication Security
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Seed Credentials (Development Simulation Only)
DEMO_ADMIN_EMAIL=admin@finguard.ai
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_ANALYST_EMAIL=analyst@finguard.ai
DEMO_ANALYST_PASSWORD=Analyst@123456

# Model Storage Directory
MODEL_DIR=ml_pipeline/models
